{
  "odexis": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash ./plugin/hooks/session-start.sh",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|read_file|view_file",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./plugin/hooks/shell-read.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "bash ./plugin/hooks/stop.sh",
        "timeout": 10
      }
    ]
  }
}
