{
  "language": "{{LANGUAGE}}",
  "outputStyle": "Concise",
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)",
      "Bash(gh repo create *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(npm publish *)",
      "PowerShell(git push *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh release create *)",
      "PowerShell(gh repo create *)",
      "PowerShell(gh issue create *)",
      "PowerShell(gh issue comment *)",
      "PowerShell(gh pr comment *)",
      "PowerShell(gh pr review *)",
      "PowerShell(npm publish *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets/**)"
    ],
    "blockWritesOutsideWorkingDirectories": true
  }
}
